{
  "name": "@whilesmart/design",
  "version": "0.2.0",
  "type": "module",
  "description": "WhileSmart design system: Vue 3 components, layouts, composables, and design tokens",
  "license": "MIT",
  "author": "WhileSmart",
  "homepage": "https://github.com/whilesmart/design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whilesmart/design.git"
  },
  "keywords": [
    "vue",
    "components",
    "design-system",
    "design-tokens",
    "whilesmart"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "default": "./dist/layouts.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "default": "./dist/composables.js"
    },
    "./timelines": {
      "types": "./dist/timelines/index.d.ts",
      "default": "./dist/timelines.js"
    },
    "./timelines/style.css": "./dist/timelines.css",
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "default": "./dist/canvas.js"
    },
    "./canvas/style.css": "./dist/canvas.css",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./styles": "./dist/design.css",
    "./tokens/*": "./dist/css/tokens/*",
    "./icons/*": "./dist/icons/*",
    "./package.json": "./package.json",
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "default": "./dist/viewer.js"
    },
    "./component-styles": "./dist/style.css"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.0.0",
    "@vue-flow/core": "^1.48.2"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@iconify/vue": "^5.0.1"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.90",
    "@iconify-json/solar": "^1.2.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue-flow/core": "^1.48.2",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.1.3"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:types && npm run build:vite && npm run build:css",
    "build:lib": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:vite": "tsc -p tsconfig.vite.json",
    "build:css": "node scripts/build-css.mjs",
    "test": "vitest run",
    "check": "node scripts/check-tokens.mjs && npm test && npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependenciesMeta": {
    "@vue-flow/core": {
      "optional": true
    }
  }
}
